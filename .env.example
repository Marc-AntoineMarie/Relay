# Clé API Anthropic — requise en v0.1.
# Copier ce fichier en `.env` et renseigner la vraie clé. Le `.env` n'est jamais commité.
ANTHROPIC_API_KEY=sk-ant-...

# Backends GRATUITS pour tester sans toucher au quota Claude (--provider <nom>) :
# GEMINI_API_KEY=...        # gratuit — https://ai.google.dev  (--provider gemini --model gemini-2.0-flash)
# GROQ_API_KEY=...          # gratuit — https://console.groq.com (--provider groq --model llama-3.3-70b-versatile)
# OPENROUTER_API_KEY=...    # modèles ':free' — https://openrouter.ai (--provider openrouter --model ...)
# DEEPSEEK_API_KEY=...      # très bon marché — https://platform.deepseek.com (--provider deepseek --model deepseek-chat)
# Ollama (local, aucune clé) : --provider ollama --model <modèle installé>

# Fournisseurs additionnels (v0.2+)
# OPENAI_API_KEY=sk-...
